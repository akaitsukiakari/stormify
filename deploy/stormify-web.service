[Unit]
Description=Stormify dashboard
After=network-online.target
Wants=network-online.target

[Service]
User=stormify
Environment=STORMIFY_CONFIG=/etc/stormify/config.toml
ExecStart=/opt/stormify/venv/bin/stormify web
Restart=always
RestartSec=10
MemoryMax=150M
# Past that, restart the service instead of swapping it out: a swapping Pi Zero locks up entirely.
MemorySwapMax=0

[Install]
WantedBy=multi-user.target
