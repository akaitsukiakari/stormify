{
  "stormify_rules": 1,
  "rules": [
    {
      "name": "Hurricane center advisories, Atlantic",
      "events": ["Tropical Cyclone Public Advisory"],
      "tags_any": ["atlantic"],
      "scope": {"offices": ["NHC"]},
      "action": "push",
      "priority": 3,
      "on_update": "significant"
    },
    {
      "name": "Hurricane center updates, Atlantic",
      "events": ["Tropical Cyclone Update"],
      "tags_any": ["atlantic"],
      "scope": {"offices": ["NHC"]},
      "action": "push",
      "priority": 3,
      "on_update": "any"
    },
    {
      "name": "Tropical watches, nationwide",
      "events": ["Hurricane Watch", "Tropical Storm Watch", "Storm Surge Watch"],
      "scope": {"nationwide": true},
      "action": "push",
      "priority": 3,
      "on_update": "new_only"
    }
  ]
}
